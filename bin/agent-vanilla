#!/usr/bin/env python3
"""Launch a fresh Codex or Claude session without user/repo customization."""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


EXIT_USAGE = 2
BLOCKED_CODEX_ARGS = {"-c", "--config", "--profile"}
BLOCKED_CLAUDE_ARGS = {
    "-c",
    "--continue",
    "-r",
    "--resume",
    "--agent",
    "--agents",
    "--add-dir",
    "--append-system-prompt",
    "--append-system-prompt-file",
    "--mcp-config",
    "--plugin-dir",
    "--settings",
    "--setting-sources",
    "--system-prompt",
    "--system-prompt-file",
}


class UsageError(RuntimeError):
    pass


def usage() -> str:
    return """Usage:
  agent-vanilla codex [--workdir PATH] [--dry-run] [-- CODEX_ARGS...]
  agent-vanilla claude [--workdir PATH] [--dry-run] [-- CLAUDE_ARGS...]

Starts a fresh provider session with built-in defaults. User/repo instructions,
custom skills, hooks, plugins, MCP configuration, and resumed custom context are
excluded. Authentication and provider-built-in capabilities remain available.
"""


def parse_args(argv: list[str]) -> tuple[str, Path, bool, list[str]]:
    if not argv or argv[0] in {"-h", "--help"}:
        print(usage(), end="")
        raise SystemExit(0)
    provider = argv[0]
    if provider not in {"codex", "claude"}:
        raise UsageError("provider must be 'codex' or 'claude'")

    workdir = Path.cwd()
    dry_run = False
    provider_args: list[str] = []
    index = 1
    while index < len(argv):
        arg = argv[index]
        if arg == "--":
            provider_args.extend(argv[index + 1 :])
            break
        if arg == "--workdir":
            index += 1
            if index >= len(argv):
                raise UsageError("--workdir requires a path")
            workdir = Path(argv[index])
        elif arg == "--dry-run":
            dry_run = True
        else:
            provider_args.append(arg)
        index += 1

    workdir = workdir.expanduser().resolve()
    if not workdir.is_dir():
        raise UsageError(f"workdir is not a directory: {workdir}")
    return provider, workdir, dry_run, provider_args


def reject_customization(provider: str, args: list[str]) -> None:
    blocked = BLOCKED_CODEX_ARGS if provider == "codex" else BLOCKED_CLAUDE_ARGS
    for arg in args:
        option = arg.split("=", 1)[0]
        if option in blocked:
            raise UsageError(
                f"{option} is not allowed in a vanilla session because it can restore custom configuration or context"
            )


def executable_candidates(name: str) -> list[Path]:
    candidates: list[Path] = []
    seen: set[Path] = set()
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        if not entry:
            continue
        candidate = Path(entry) / name
        if candidate.is_file() and os.access(candidate, os.X_OK):
            absolute = candidate.absolute()
            if absolute not in seen:
                seen.add(absolute)
                candidates.append(absolute)
    return candidates


def resolve_provider_binary(provider: str) -> Path:
    override = os.environ.get(f"AGENT_VANILLA_{provider.upper()}_BIN")
    if override:
        candidate = Path(override).expanduser().resolve()
        if not candidate.is_file() or not os.access(candidate, os.X_OK):
            raise UsageError(f"provider binary is not executable: {candidate}")
        return candidate

    candidates = executable_candidates(provider)
    if provider == "codex":
        local_wrapper = Path.home() / ".local" / "bin" / "codex"
        candidates = [candidate for candidate in candidates if candidate != local_wrapper]
    if not candidates:
        raise UsageError(
            f"could not find an unwrapped {provider} executable; set AGENT_VANILLA_{provider.upper()}_BIN"
        )
    return candidates[0].resolve()


def git_root(workdir: Path) -> Path:
    result = subprocess.run(
        ["git", "-C", str(workdir), "rev-parse", "--show-toplevel"],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
    )
    if result.returncode == 0 and result.stdout.strip():
        return Path(result.stdout.strip()).resolve()
    return workdir


def ancestor_paths(workdir: Path, root: Path) -> list[Path]:
    paths: list[Path] = []
    current = workdir
    while True:
        paths.append(current)
        if current == root or current.parent == current:
            break
        current = current.parent
    return paths


def custom_codex_skills(workdir: Path) -> list[Path]:
    roots = [Path.home() / ".agents" / "skills"]
    repo_root = git_root(workdir)
    for ancestor in ancestor_paths(workdir, repo_root):
        roots.extend((ancestor / ".agents" / "skills", ancestor / ".codex" / "skills"))

    skills: set[Path] = set()
    for root in roots:
        if root.is_dir():
            skills.update(path.resolve() for path in root.rglob("SKILL.md") if path.is_file())
    return sorted(skills)


def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=True)


def codex_profile_home(workdir: Path) -> Path:
    state_root = Path(
        os.environ.get(
            "AGENT_VANILLA_STATE_HOME",
            str(Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "agent-vanilla"),
        )
    ).expanduser()
    digest = hashlib.sha256(str(workdir).encode("utf-8")).hexdigest()[:16]
    return (state_root / "codex" / digest).resolve()


def write_codex_profile(workdir: Path) -> tuple[Path, list[Path]]:
    profile_home = codex_profile_home(workdir)
    profile_home.mkdir(parents=True, exist_ok=True, mode=0o700)
    profile_home.chmod(0o700)

    auth_source = Path(
        os.environ.get("AGENT_VANILLA_CODEX_AUTH", str(Path.home() / ".codex" / "auth.json"))
    ).expanduser().resolve()
    if not auth_source.is_file():
        raise UsageError(f"Codex authentication file is missing: {auth_source}")
    auth_target = profile_home / "auth.json"
    if auth_target.is_symlink() or auth_target.exists():
        if not auth_target.is_symlink() or auth_target.resolve() != auth_source:
            auth_target.unlink()
    if not auth_target.exists():
        auth_target.symlink_to(auth_source)

    skills = custom_codex_skills(workdir)
    lines = [
        "# Generated by agent-vanilla. Manual edits are overwritten.",
        "project_doc_max_bytes = 0",
        "check_for_update_on_startup = false",
        "",
        f"[projects.{toml_string(str(workdir))}]",
        'trust_level = "untrusted"',
    ]
    for skill in skills:
        lines.extend(
            [
                "",
                "[[skills.config]]",
                f"path = {toml_string(str(skill))}",
                "enabled = false",
            ]
        )
    config = "\n".join(lines) + "\n"
    fd, temporary = tempfile.mkstemp(prefix="config.toml.", dir=profile_home, text=True)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(config)
        os.replace(temporary, profile_home / "config.toml")
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return profile_home, skills


def build_launch(provider: str, workdir: Path, provider_args: list[str]) -> tuple[list[str], dict[str, str], dict[str, object]]:
    reject_customization(provider, provider_args)
    binary = resolve_provider_binary(provider)
    env = os.environ.copy()
    metadata: dict[str, object] = {
        "provider": provider,
        "fresh_session": True,
        "workdir": str(workdir),
        "provider_binary": str(binary),
    }
    if provider == "claude":
        command = [str(binary), "--safe-mode", *provider_args]
        metadata["isolation"] = "claude-native-safe-mode"
    else:
        profile_home, skills = write_codex_profile(workdir)
        env["CODEX_HOME"] = str(profile_home)
        env["CODEX_NO_TMUX"] = "1"
        command = [str(binary), "-C", str(workdir), *provider_args]
        metadata.update(
            {
                "isolation": "isolated-codex-home",
                "codex_home": str(profile_home),
                "disabled_repo_and_user_skills": [str(path) for path in skills],
            }
        )
    return command, env, metadata


def main(argv: list[str]) -> int:
    try:
        provider, workdir, dry_run, provider_args = parse_args(argv)
        command, env, metadata = build_launch(provider, workdir, provider_args)
    except UsageError as error:
        print(f"agent-vanilla: {error}", file=sys.stderr)
        print(usage(), file=sys.stderr, end="")
        return EXIT_USAGE

    if dry_run:
        metadata["command"] = command
        print(json.dumps(metadata, indent=2, sort_keys=True))
        return 0
    os.chdir(workdir)
    os.execve(command[0], command, env)
    return 127


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
